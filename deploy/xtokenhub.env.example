# XTokenHub systemd 环境变量
#
# 安装位置：/etc/default/xtokenhub
# 该文件在 systemd 启动 xtokenhub 时注入环境变量。应用的出网请求
# （价格表同步、渠道上游调用、余额查询）都用 Go 默认 Transport，
# 因此会读取下面的代理变量。
#
# 注意：不要在这里定义 XT_ROOT / 路径类变量 —— 单元文件里的
# WorkingDirectory 与 ExecStart 不支持从本文件展开。

# ---------- 出网代理 ----------
# 设备无法直连 GitHub（价格表源）时必填。本机 mihomo 常见端口 7890。
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,192.168.0.0/16

# ---------- 配置覆盖（可选） ----------
# 优先级：环境变量 XT_HUB_* > configs/config.yaml > 内置默认值
# 层级分隔符是双下划线。
#
# XT_HUB_SERVER__PORT=9192
# XT_HUB_SERVER__HOST=0.0.0.0
# XT_HUB_LOG__LEVEL=info
# XT_HUB_GATEWAY__REQUIRE_KEY=true
#
# 计价与展示（价格表默认会随首次启动同步一次）
# XT_HUB_PRICING__ENABLED=true
# XT_HUB_PRICING__AUTO_SYNC=true
# XT_HUB_PRICING__SYNC_INTERVAL_HOURS=24
# XT_HUB_PRICING__TIMEOUT_SECONDS=20
# XT_HUB_BILLING__DISPLAY_CURRENCY=CNY
# XT_HUB_BILLING__USD_CNY_RATE=7.2
# XT_HUB_BILLING__MONTHLY_BUDGET_USD=20
#
# 日志保留
# XT_HUB_RETENTION__MAX_DAYS=90
